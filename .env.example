# H5 only proxies to an independently deployed Python analysis engine.
ANALYTICS_API_BASE_URL=
ANALYTICS_ALLOWED_HOSTS=
ANALYTICS_SHARED_SECRET=

# Default server-managed Kimi. Set the real Key only in EdgeOne environment
# variables or a local .env.local file that is excluded from Git.
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2.6

# Comma-separated HTTPS hosts accepted by the server-side proxy.
LLM_ALLOWED_HOSTS=api.openai.com,api.moonshot.cn
